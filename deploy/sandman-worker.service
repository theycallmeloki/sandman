[Unit]
Description=Sandman execution worker (joins a control plane)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/sandman/worker.env
# Braced ${VAR} always yields a word even when empty ("" = flag unset, which
# the worker accepts): an unbraced $VAR drops empty words, which would make a
# flag consume its neighbor and derail the command line. $SANDBOX_LABELS is
# the exception — it must split on whitespace to repeat -label.
ExecStart=/usr/local/bin/sandman worker -name ${SANDBOX_WORKER_NAME} -control ${SANDBOX_CONTROL} -port ${SANDBOX_PORT} -advertise ${SANDBOX_ADVERTISE} $SANDBOX_LABELS
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

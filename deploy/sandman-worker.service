[Unit]
Description=Sandman execution worker (joins a control plane)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The worker also runs unprivileged: it reaches docker through the socket
# group, not root. `make install` creates the account. Unlike the daemon,
# this unit does NOT set PrivateTmp: the worker materializes job sides in
# /tmp and passes those paths to the host dockerd over the socket, and
# dockerd resolves bind mounts in the host mount namespace, where a
# private /tmp would not exist. See sandman-worker-hardening.conf.
User=sandman
Group=sandman
SupplementaryGroups=docker
# HOME is only the docker CLI/config location; the worker itself keeps no
# durable state. StateDirectory also guarantees the path exists.
StateDirectory=sandman
StateDirectoryMode=0750
Environment=HOME=/var/lib/sandman
# A bare `sandman worker` joins the fleet with zero configuration: the
# name defaults to the hostname, the control plane is discovered via mDNS
# (role=daemon on the LAN), and the exec endpoint binds loopback. For the
# control plane to place jobs here, -advertise must name a host:port the
# daemon can dial (and -port must match); the endpoint is unauthenticated,
# so only advertise on a trusted LAN. The curl installer
# (README "Add an execution worker") writes this unit with the flags
# baked in — edit them here and `systemctl restart sandman-worker` to
# change name, advertise address, or placement labels.
# Optional control-plane Basic Auth; absent file keeps the historical
# unauthenticated trusted-LAN worker. The daemon must use the same pair.
EnvironmentFile=-/etc/sandman/auth.env
ExecStart=/usr/local/bin/sandman worker
# a crashed or OOM-killed worker must come back: without a restart
# policy the control plane's host TTL silently drops it from placement
# (fleet capacity lost with no signal)
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

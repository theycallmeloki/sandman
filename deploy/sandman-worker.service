[Unit]
Description=Sandman execution worker (joins a control plane)
# The worker runs containers through containerd: it must not start before
# the runtime is up (Wants, not Requires: a containerd restart must not
# take the worker's registration down with it).
After=network-online.target containerd.service
Wants=network-online.target containerd.service

[Service]
Type=simple
# A bare `sandman worker` joins the fleet with zero configuration: the
# name defaults to the hostname, the control plane is discovered via mDNS
# (role=daemon on the LAN), and the exec endpoint binds loopback. For the
# control plane to place jobs here, -advertise must name a host:port the
# daemon can dial (and -port must match); the endpoint is unauthenticated,
# so only advertise on a trusted LAN. The curl installer
# (README "Add an execution worker") writes this unit with the flags
# baked in — edit them here and `systemctl restart sandman-worker` to
# change name, advertise address, or placement labels.
ExecStart=/usr/local/bin/sandman worker
# a crashed or OOM-killed worker must come back: without a restart
# policy the control plane's host TTL silently drops it from placement
# (fleet capacity lost with no signal)
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

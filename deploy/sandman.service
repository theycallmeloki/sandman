[Unit]
Description=Sandman fabric node (zeroconf peer-to-peer docker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/lib/sandman/jobs
ExecStart=/usr/local/bin/sandman daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

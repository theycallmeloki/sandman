[Unit]
Description=Sandman fabric node (zeroconf peer-to-peer container fabric)
# The execution backend speaks containerd directly: the daemon must not
# start before the container runtime is up, or every job it spawns would
# fail as unprovisionable. Wants (not Requires) so a containerd restart
# does not take the control plane down with it.
After=network-online.target containerd.service
Wants=network-online.target containerd.service

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/lib/sandman/jobs
ExecStart=/usr/local/bin/sandman daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
